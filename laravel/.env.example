APP_NAME=Laravel
# Footer credit. Leave POWERED_BY blank to hide "Powered by …".
# Contact lines open from that credit. Leave any of them blank to hide that line.
POWERED_BY="Whizdom Engineering"
POWERED_BY_EMAIL=hello@wengineering.ng
POWERED_BY_PHONE=
POWERED_BY_WEBSITE=https://www.wengineering.ng
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Root domain for school subdomains: <school>.APP_DOMAIN (admin.APP_DOMAIN = platform)
APP_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# bcrypt (default) or argon2id - used for all password hashes, including legacy imports
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=africanchild
DB_USERNAME=root
DB_PASSWORD=

# Legacy database (read-only import source for `php artisan legacy:import <schoolSlug>`).
# Load the legacy dump into this database first; never commit real credentials.
# Imported logins are hashed with the app hasher (bcrypt by default; set HASH_DRIVER=argon2id for Argon2id).
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=legacy
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# Seeding (php artisan db:seed)
SEED_PLATFORM_EMAIL=platform@schools.local
SEED_PLATFORM_PASSWORD=password
SEED_ADMIN_EMAIL=admin@africanchildcollege.org
SEED_ADMIN_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
